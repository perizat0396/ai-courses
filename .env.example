# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Секретный ключ (service_role). Нужен только серверу — для добавления студентов из админки. Никому не показывайте.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ИИ-помощник (Google Gemini API). Без ключа помощник просто скрыт.
GEMINI_API_KEY=AIza...
# Модель: по умолчанию gemini-flash-latest (всегда актуальная Flash). Можно указать конкретную, напр. gemini-3.6-flash
GEMINI_MODEL=gemini-flash-latest
# Дневные лимиты на одного студента
AI_CHAT_DAILY_LIMIT=40
AI_REVIEW_DAILY_LIMIT=15
