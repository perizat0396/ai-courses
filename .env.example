# Supabase → кнопка Connect вверху проекта (URL) и Project Settings → API Keys (ключи)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) — или старый anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Secret key (sb_secret_...) — или старый service_role. Нужен только серверу — для добавления студентов из админки. Никому не показывайте.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ИИ-помощник (Google Gemini API). Без ключа помощник просто скрыт.
GEMINI_API_KEY=AIza...
# Модель: по умолчанию gemini-flash-latest (всегда актуальная Flash). Можно указать конкретную, напр. gemini-3.6-flash
# Модели Gemini: для чата студентов и для проверки заданий; запасные — через запятую
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REVIEW_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
# ИИ для студентов (чат-помощник и самопроверка): on — включить. По умолчанию ИИ только у преподавателя.
AI_STUDENT=off
# Дневные лимиты на одного студента
AI_CHAT_DAILY_LIMIT=40
AI_REVIEW_DAILY_LIMIT=15
